# Konfigurasi Database PostgreSQL Supabase (Transaction Pooler)
# Salin file ini menjadi .env untuk pengujian lokal, atau masukkan ke
# Vercel Project Settings -> Environment Variables saat deploy.

DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.yourprojectref
DB_PASS=your_supabase_database_password

# Kunci rahasia untuk signing cookie autentikasi stateless (minimal 32 karakter acak)
APP_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter
